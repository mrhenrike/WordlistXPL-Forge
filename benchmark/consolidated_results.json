  "key_findings": {
    "cogpie_standalone_scaling": "CogPIE standalone improves dramatically with corpus scale: hit@10 0.8%->24.05%, hit@100 8%->59.3%, hit@1000 68.4%->75.95% (500k->1M train), demonstrating Markov/PCFG benefits from larger training data",
    "cogpie_dominance_high_budget": "CogPIE reaches 67.5-69.0% at hit@1000-10000 (500K), 48.0% in comparative 1M/500t, and 50.15% in comparative 1M/2000t, surpassing CUPP at hit@10000 across all scales",
    "cupp_dominance_low_budget": "CUPP wins at hit@10 (6-7.5% vs 0-1.0%) due to direct concatenation matching simple passwords",
    "standalone_vs_comparative_gap": "CogPIE standalone hit@1000 (75.95%) exceeds comparative (28.8%) because standalone uses all PII-bearing targets while comparative draws random targets (lower PII density)",
    "saturation_effect": "CogPIE saturates at hit@1000 across all experiments: 68.4% (500K standalone), 75.95% (1M standalone), 48.0% (1M comparative)",
    "markov_collapse_at_scale": "Markov-3 collapses from 28.5% (500K) to 3.2% (1M/500t) to 4.8% (1M/2000t): statistical models dilute with corpus size while cognitive models retain PII-specific patterns",
    "gpu_2k_confirms_trends": "2000-target benchmark confirms 500-target trends with higher statistical significance: CogPIE 50.15% vs CUPP 47.55% vs Markov 4.80%; CogPIE surpasses CUPP at hit@10000 with 1003 vs 951 absolute hits",
    "frequency_levenshtein_random_zero": "Non-profile-aware approaches score 0% on PII-bearing targets at any scale, confirming the necessity of personal information in targeted guessing",
    "best_result": "Peak performance: CogPIE 75.95% hit rate at budget 1000 with 1M training corpus and 2000 PII-bearing targets (MRR 0.137, median rank 35)"
  },
